# Araya managed static routing v1
Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# Preserve provider certificate validation. No directory listings.
RewriteRule ^\.well-known/ - [L]

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^arayainternusa\.co\.id$ [NC]
RewriteRule ^ https://arayainternusa.co.id%{REQUEST_URI} [R=301,L,NE]

# Equivalent legacy content. Other WordPress pages and downloads are retired.
RewriteRule ^araya(?:/index\.php|/)?$ / [R=301,L,NE,QSD]
RewriteRule ^araya/(?:about-us|about)(?:/index\.php|/)?$ /#about [R=301,L,NE,QSD]
RewriteRule ^araya/services(?:/index\.php|/)?$ /#services [R=301,L,NE,QSD]
RewriteRule ^araya/services/marine(?:/index\.php|/)?$ /#marine-services [R=301,L,NE,QSD]
RewriteRule ^araya/services/industrial(?:/index\.php|/)?$ /#industrial-services [R=301,L,NE,QSD]
RewriteRule ^araya/services/automation(?:/index\.php|/)?$ /#automation-services [R=301,L,NE,QSD]
RewriteRule ^araya/team(?:/index\.php|/)?$ /#leadership [R=301,L,NE,QSD]
RewriteRule ^araya/(?:contact|contact-2)(?:/index\.php|/)?$ /#contact [R=301,L,NE,QSD]
RewriteRule ^araya/ - [G,L]

RewriteRule ^index\.php$ / [R=301,L,QSD]
RewriteRule ^(noris|comap|marine|industrial|automation)$ /$1/ [R=301,L]
RewriteRule ^$ index.html [L]
RewriteRule ^index\.html$ - [L]
RewriteRule ^(noris|comap|marine|industrial|automation)/$ $1/index.html [L]
RewriteRule ^(noris|comap|marine|industrial|automation)/index\.html$ - [L]
RewriteRule ^(robots\.txt|sitemap\.xml)$ - [L]
RewriteRule ^(assets/[A-Za-z0-9_./-]+\.(?:css|js|svg|webp|png|jpe?g|woff2|pdf|txt))$ - [L]
# Unknown URLs and old root archives never fall through to existing files/PHP.
RewriteRule ^ - [R=404,L]

<IfModule mod_headers.c>
Header set Cache-Control "no-cache"
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
